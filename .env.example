# Development examples only. Copy to .env locally; never commit credentials or JWTs.
APP_NETWORK_NAME=vigo-app
STORAGE_BIND_ADDRESS=127.0.0.1
STORAGE_VOLUME_NAME=vigo-storage-data
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vigo_storage_service
SPRING_DATASOURCE_USERNAME=replace_with_development_postgres_user
SPRING_DATASOURCE_PASSWORD=replace_locally
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Compose assumes Auth container named `auth` in vigo-app (its image listens on 8080).
# If Auth runs on the host instead, use http://host.docker.internal:8080/.well-known/jwks.json;
# storage/compose.yml has no extra_hosts entry, so add host-gateway mapping in your own override.
AUTH_JWKS_URI=http://auth:8080/.well-known/jwks.json
# Must exactly match the actual Auth access token issuer, independently of where JWKS is fetched.
# Typical host-run Auth: http://localhost:8080 (tokens carry the browser-facing issuer).
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=vigo-api
STORAGE_FS_ROOT=/var/lib/vigo/storage
STORAGE_OUTBOX_DELAY_MS=1000

# Direct JVM monitoring bind (Compose intentionally overrides internally, never publishes 9082).
MANAGEMENT_ADDRESS=127.0.0.1
