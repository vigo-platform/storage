# Development examples only. Copy to .env locally; never commit credentials or JWTs.
APP_NETWORK_NAME=vigo-app
STORAGE_BIND_ADDRESS=127.0.0.1
STORAGE_VOLUME_NAME=vigo-storage-data
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vigo_storage_service
SPRING_DATASOURCE_USERNAME=replace_with_development_postgres_user
SPRING_DATASOURCE_PASSWORD=replace_locally
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Compose assumes Auth container named `auth` in vigo-app (its image listens on 8080).
# If Auth runs on the host instead, use http://host.docker.internal:8080/.well-known/jwks.json;
# storage/compose.yml has no extra_hosts entry, so add host-gateway mapping in your own override.
AUTH_JWKS_URI=http://auth:8080/.well-known/jwks.json
# Must exactly match the actual Auth access token issuer, independently of where JWKS is fetched.
# This is the default issuer in Auth's application.yaml. Override it to match your Auth deployment.
JWT_ISSUER=auth.vigoapp.ir
JWT_AUDIENCE=vigo-api
# Direct User REST origin on vigo-app. For a host-run User use http://localhost:8081.
STORAGE_USER_BASE_URL=http://user:8081
# Plain HTTP is for local development only. Use the trusted internal HTTPS origin in production.
STORAGE_USER_ALLOW_HTTP=true
STORAGE_FS_ROOT=/var/lib/vigo/storage
STORAGE_OUTBOX_DELAY_MS=1000

# ── Object storage ───────────────────────────────────────────────────────────
# filesystem keeps bytes on the local volume; s3 uploads them to a ParsPack-style
# S3-compatible bucket. Copy this file to .env and fill in the values there.
STORAGE_BACKEND=filesystem
# Only used when STORAGE_BACKEND=s3. Leave empty for the local filesystem backend.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
# Never commit real credentials. Create a dedicated key pair for this service and
# rotate it if it has ever been shared in an archive, chat or ticket.
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# ParsPack and most S3-compatible providers require path-style addressing.
STORAGE_S3_PATH_STYLE=true
# Lifetime of temporary private-download links: between 1 second and 60 minutes.
STORAGE_PRESIGN_TTL=PT10M
# Local scratch space for staged uploads. Needed even with the s3 backend, because
# files are validated on disk under STORAGE_FS_ROOT before reaching the bucket.

# Direct JVM monitoring bind (Compose intentionally overrides internally, never publishes 9082).
MANAGEMENT_ADDRESS=127.0.0.1
