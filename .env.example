# ─────────────────────────────────────────────────────────────────────────────
# Vigo Storage Service — local environment template
#
# Copy this file to `.env` next to compose.yml and fill in the values:
#
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Values marked REQUIRED make
# Compose fail fast when they are missing; values with a default may be left
# untouched. Only variables listed in compose.yml reach the container.
# ─────────────────────────────────────────────────────────────────────────────

# ── Compose wiring ───────────────────────────────────────────────────────────
# Network shared by the User and Storage projects; must match the other compose
# files so they can reach each other and the shared PostgreSQL/Kafka.
APP_NETWORK_NAME=vigo-app
# Host address the HTTP port is published on. Loopback is the safe default.
STORAGE_BIND_ADDRESS=127.0.0.1
# Docker volume that keeps local bytes across container recreation.
STORAGE_VOLUME_NAME=vigo-storage-data

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# The database must already exist (development/postgres/init-dbs.sql creates
# vigo_storage_service). Flyway owns the tables inside it.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vigo_storage_service
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
# Production should use a dedicated least-privileged login, not the superuser.

# ── Kafka ────────────────────────────────────────────────────────────────────
# Container name on the shared network; from the host use localhost:29092.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Authentication (JWT) ─────────────────────────────────────────────────────
# Compose assumes an Auth container named `auth` listening on 8080 inside the
# vigo-app network. If Auth runs on the host instead, use
# http://host.docker.internal:8080/.well-known/jwks.json and add a host-gateway
# mapping in a compose override; compose.yml has no extra_hosts entry.
AUTH_JWKS_URI=http://auth:8080/.well-known/jwks.json
# The issuer must exactly match the `iss` claim Auth signs. It is independent of
# where the JWKS is downloaded from, so it may be a public name such as below.
JWT_ISSUER=auth.vigoapp.ir
JWT_AUDIENCE=vigo-api

# ── User service lookup ──────────────────────────────────────────────────────
# Storage validates every request by asking User for the caller's profile, so
# this origin must be reachable from the container on the shared network.
STORAGE_USER_BASE_URL=http://user:8081
# Plain HTTP is for local development only; production must use HTTPS.
STORAGE_USER_ALLOW_HTTP=true

# ── Object storage backend ───────────────────────────────────────────────────
#   filesystem → bytes stay on the local volume (default, simplest for local runs)
#   s3         → bytes are uploaded to a ParsPack-style S3-compatible bucket
#
# Switching backends does not migrate existing objects: data written by the
# filesystem backend is not readable through the s3 backend.
STORAGE_BACKEND=filesystem

# --- Only needed when STORAGE_BACKEND=s3 ------------------------------------
# HTTPS endpoint of the provider, with no path or bucket in it.
#   example: https://<account>.parspack.net
STORAGE_S3_ENDPOINT=
# Provider region. ParsPack and most compatible providers accept us-east-1.
STORAGE_S3_REGION=us-east-1
# Bucket name, exactly as created in the provider panel.
#   example: my-vigo-bucket
STORAGE_S3_BUCKET=
# S3 access key and secret for THIS service only.
#   Required with s3. Never commit real values, never reuse personal keys, and
#   rotate any key that has been shared in an archive, chat or ticket.
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# Path-style addressing is required by ParsPack and most S3-compatible vendors.
STORAGE_S3_PATH_STYLE=true

# --- Behaviour shared by both backends --------------------------------------
# Local scratch directory. Uploads are staged and validated here first, then
# written to the bucket or promoted to the local objects directory. Required
# even with the s3 backend.
STORAGE_FS_ROOT=/var/lib/vigo/storage
# How often the outbox checks for unpublished events, in milliseconds.
STORAGE_OUTBOX_DELAY_MS=1000
# Lifetime of temporary private-download links. Must be between 1 second and
# 60 minutes; shorter is safer.
STORAGE_PRESIGN_TTL=PT10M

# ── Management ───────────────────────────────────────────────────────────────
# Compose overrides this internally so Prometheus can scrape on the shared
# network, and never publishes port 9082 to the host.
MANAGEMENT_ADDRESS=127.0.0.1
