meta {
  name: 05 Add version
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/files/{{file_id}}/versions
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{coach_token}}
}

body:multipart-form {
  file: @file({{upload_path}})
  change_note: Increased workout volume
}

tests {
  test("Expected HTTP status", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Snake-case bilingual response envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body).to.have.all.keys("success", "code", "message", "message_fa", "data", "timestamp");
    expect(body.message_fa).to.be.a("string").and.not.empty;
  });
  test("Server assigned version", function () {
    expect(res.getBody().data.version).to.be.greaterThan(1);
  });
}

docs {
  Owner COACH only while an active relation exists. ADMIN and ATHLETE: 403; missing/deleted file: 404;
  no active relation: 403 NO_ACTIVE_RELATION. Version is server-owned and monotonic under locking.
  Same validation/size errors as upload.

  Example 201 data: {"version":2,"original_name":"program.txt","content_type":"text/plain; charset=UTF-8","size_bytes":37,"checksum_sha256":"64-hex-sha256","change_note":"Increased workout volume","uploaded_by":"d489391f-73e9-4545-ac65-7dd2552c1a9a","uploaded_at":"2026-10-31T12:00:00Z"}
}
